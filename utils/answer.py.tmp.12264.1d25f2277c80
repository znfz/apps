import os
import ssl
from typing import Iterator, Tuple, List, Dict
import numpy as np
import re

from dotenv import load_dotenv
from langchain_openai import AzureChatOpenAI, AzureOpenAIEmbeddings
from langchain_core.messages import SystemMessage, HumanMessage, convert_to_messages
from langchain_core.documents import Document
from langchain_community.vectorstores import Milvus
import httpx
import certifi

load_dotenv(override=True)

# Set SSL certificate path for both sync and async clients
os.environ["SSL_CERT_FILE"] = certifi.where()

# Create custom HTTP client with certificate verification
http_client = httpx.Client(verify=certifi.where(), timeout=30.0)

MODEL = "gpt-5.2"

# AIR API / Azure-compatible embeddings (must match ingest.py)
ACCESS_TOKEN = os.getenv("ACCESS_TOKEN")
if not ACCESS_TOKEN:
    raise RuntimeError("access_token is not set in environment")

embeddings = AzureOpenAIEmbeddings(
    api_key="AIR-API",
    azure_endpoint="https://air-api.regeneron.com/v1.0/model",
    api_version="2024-08-01-preview",
    azure_deployment="text-embed-3-large",
    default_headers={"authorization-token": ACCESS_TOKEN},
    http_client=http_client,  # Use custom SSL-aware client
)

SYSTEM_PROMPT = """
You are a knowledgeable, friendly assistant representing the Drug Product Development and Technology (DPDT) group at Regeneron.

IMPORTANT: You may ONLY answer questions using information found in the context provided below.
- If the context contains information relevant to the question, use it to provide a helpful answer.
- If the context does NOT contain relevant information to answer the question, you must respond with: "I don't have information about that in my knowledge base. My expertise is limited to DPDT-related documents that have been provided to me."
- Do NOT use your general knowledge or training data to answer questions outside the provided context.
- Do NOT make up information or provide answers about topics not covered in the context.

Context:
{context}
"""

# Milvus settings (must match ingest.py)
MILVUS_HOST = os.getenv("MILVUS_HOST", "localhost")
MILVUS_PORT = int(os.getenv("MILVUS_PORT", "19530"))
MILVUS_USER = os.getenv("MILVUS_USER", "")
MILVUS_PASSWORD = os.getenv("MILVUS_PASSWORD", "")
MILVUS_DB_NAME = os.getenv("MILVUS_DB_NAME", "default")
MILVUS_SECURE = os.getenv("MILVUS_SECURE", "false").lower() == "true"
COLLECTION_NAME = os.getenv("MILVUS_COLLECTION", "files_md_embeddings")

connection_args = {
    "host": MILVUS_HOST,
    "port": MILVUS_PORT,
    "user": MILVUS_USER,
    "password": MILVUS_PASSWORD,
    "db_name": MILVUS_DB_NAME,
    "secure": MILVUS_SECURE,
}

# Match ingest.py search metric and params
search_params = {"metric_type": "IP", "params": {"ef": 64}}

# Initialize vector store for an existing collection (constructor variant)
# Some versions expect 'embedding_function', others 'embedding' — handle both.
try:
    vectorstore = Milvus(
        collection_name=COLLECTION_NAME,
        connection_args=connection_args,
        embedding_function=embeddings,  # preferred in newer versions
        search_params=search_params,
        # text_field="text",  # set if you changed this during ingest
    )
except TypeError:
    # Fallback for versions that expect 'embedding'
    vectorstore = Milvus(
        collection_name=COLLECTION_NAME,
        connection_args=connection_args,
        embedding=embeddings,  # older arg name
        search_params=search_params,
        # text_field="text",
    )

# Base MMR retriever configuration (will be dynamically adjusted per query)
BASE_K = 8
BASE_FETCH_K = 60
LAMBDA_MULT = 0.5

# LLM - Use AIR API for chat model
llm = AzureChatOpenAI(
    api_key="AIR-API",
    azure_endpoint="https://air-api.regeneron.com/v1.0/model",
    api_version="2024-08-01-preview",
    azure_deployment=MODEL,
    default_headers={"authorization-token": ACCESS_TOKEN},
    temperature=0,
    http_client=http_client,  # Use custom SSL-aware client
)


def analyze_query_complexity(question: str) -> dict:
    """
    Analyze query to determine optimal retrieval parameters.

    Returns:
        dict with keys:
            - complexity_score: 0.0-1.0 (simple to complex)
            - query_type: 'factual', 'comparison', 'procedural', 'analytical'
            - recommended_k: suggested number of documents to retrieve
            - recommended_fetch_k: suggested candidate pool size
    """
    question_lower = question.lower().strip()

    # Initialize scoring components
    complexity_indicators = {
        'multi_part': 0,
        'comparison': 0,
        'analytical': 0,
        'procedural': 0,
        'breadth': 0
    }

    # Multi-part question detection (multiple questions or aspects)
    multi_part_patterns = [
        r'\?.*\?',  # Multiple question marks
        r'\band\b.*\?',  # "what is X and Y?"
        r'\bor\b.*\?',  # "X or Y?"
        r'\d+\)',  # Numbered lists (1), 2), etc.)
        r'[,;].*[,;]',  # Multiple clauses
        r'\b(also|additionally|furthermore|moreover)\b',
    ]
    if any(re.search(pattern, question_lower) for pattern in multi_part_patterns):
        complexity_indicators['multi_part'] = 0.3

    # Comparison question detection
    comparison_keywords = [
        'compare', 'contrast', 'difference', 'versus', 'vs', 'between',
        'similar', 'differ', 'distinguish', 'comparison'
    ]
    if any(keyword in question_lower for keyword in comparison_keywords):
        complexity_indicators['comparison'] = 0.25

    # Analytical question detection
    analytical_keywords = [
        'why', 'how', 'explain', 'analyze', 'evaluate', 'assess',
        'relationship', 'impact', 'effect', 'cause', 'reason',
        'implications', 'significance', 'factors', 'consider'
    ]
    analytical_count = sum(1 for keyword in analytical_keywords if keyword in question_lower)
    if analytical_count > 0:
        complexity_indicators['analytical'] = min(0.25, analytical_count * 0.1)

    # Procedural/process question detection
    procedural_keywords = [
        'steps', 'process', 'procedure', 'protocol', 'method',
        'how to', 'workflow', 'sequence', 'stages', 'phases'
    ]
    if any(keyword in question_lower for keyword in procedural_keywords):
        complexity_indicators['procedural'] = 0.2

    # Breadth indicators (requires comprehensive information)
    breadth_keywords = [
        'all', 'every', 'complete', 'comprehensive', 'entire',
        'overall', 'full', 'detailed', 'thorough', 'various', 'multiple'
    ]
    if any(keyword in question_lower for keyword in breadth_keywords):
        complexity_indicators['breadth'] = 0.2

    # Calculate overall complexity score
    complexity_score = min(1.0, sum(complexity_indicators.values()))

    # Determine query type (primary characteristic)
    query_type = 'factual'  # default
    if complexity_indicators['comparison'] > 0:
        query_type = 'comparison'
    elif complexity_indicators['procedural'] > 0:
        query_type = 'procedural'
    elif complexity_indicators['analytical'] > 0.15:
        query_type = 'analytical'

    # Simple factual question detection (overrides complexity)
    simple_patterns = [
        r'^what is\b',
        r'^define\b',
        r'^definition of\b',
        r'^who is\b',
        r'^when was\b',
    ]
    is_simple = any(re.match(pattern, question_lower) for pattern in simple_patterns)
    if is_simple and len(question_lower.split()) < 10:
        complexity_score = min(complexity_score, 0.3)
        query_type = 'factual'

    # Calculate recommended k based on complexity and type
    # Scale: simple factual (k=4-6), moderate (k=6-10), complex analytical (k=10-15)
    if query_type == 'factual' and complexity_score < 0.4:
        recommended_k = 5
        recommended_fetch_k = 40
    elif query_type == 'comparison':
        # Need diverse sources for comparison
        recommended_k = 10
        recommended_fetch_k = 80
    elif query_type == 'procedural':
        # Need sequential, comprehensive context
        recommended_k = 12
        recommended_fetch_k = 90
    elif query_type == 'analytical' or complexity_score > 0.6:
        # Need broad context for analysis
        recommended_k = 12
        recommended_fetch_k = 90
    else:
        # Moderate complexity
        base_adjustment = int(complexity_score * 8)
        recommended_k = BASE_K + base_adjustment
        recommended_fetch_k = BASE_FETCH_K + (base_adjustment * 8)

    # Cap maximum values to avoid excessive retrieval
    recommended_k = min(recommended_k, 15)
    recommended_fetch_k = min(recommended_fetch_k, 100)

    return {
        'complexity_score': round(complexity_score, 2),
        'query_type': query_type,
        'recommended_k': recommended_k,
        'recommended_fetch_k': recommended_fetch_k,
        'indicators': complexity_indicators
    }


def get_dynamic_retriever(question: str):
    """
    Create a retriever with dynamically adjusted parameters based on query complexity.

    Args:
        question: The user's question

    Returns:
        Configured retriever for the specific question
    """
    analysis = analyze_query_complexity(question)

    # Create retriever with dynamic parameters
    retriever = vectorstore.as_retriever(
        search_type="mmr",
        search_kwargs={
            "k": analysis['recommended_k'],
            "fetch_k": analysis['recommended_fetch_k'],
            "lambda_mult": LAMBDA_MULT
        },
    )

    return retriever, analysis


def calculate_confidence_score(docs: List[Document]) -> float:
    """
    Calculate confidence score (0-1) based on retrieval quality.

    Factors:
    - Average similarity scores of retrieved documents
    - Number of documents retrieved
    - Variance in similarity scores (high variance = uncertain)

    Returns:
        float: Confidence score between 0.0 and 1.0
    """
    if not docs:
        return 0.0

    # Extract similarity scores from metadata (Milvus stores as 'score' or 'distance')
    scores = []
    for doc in docs:
        # Try to get score from metadata
        if hasattr(doc, 'metadata') and isinstance(doc.metadata, dict):
            score = doc.metadata.get('score') or doc.metadata.get('distance') or doc.metadata.get('similarity')
            if score is not None:
                # Milvus with IP metric returns similarity directly (higher = better)
                scores.append(float(score))

    # If no scores found, perform manual similarity calculation
    if not scores:
        # Fallback: calculate based on document count (more docs = potentially better coverage)
        base_confidence = min(len(docs) / 8.0, 1.0)  # Normalize to 8 docs
        return round(base_confidence * 0.7, 2)  # Cap at 0.7 without similarity scores

    # Calculate confidence components
    avg_score = np.mean(scores)
    max_score = np.max(scores)
    score_variance = np.var(scores)

    # Normalize scores (assuming IP metric range ~0 to 1, higher = better)
    # If top score is very high (>0.8), boost confidence
    relevance_score = min(avg_score * 1.2, 1.0)

    # Penalize high variance (inconsistent retrieval quality)
    consistency_penalty = max(0, 1.0 - (score_variance * 2))

    # Bonus for having a very strong top match
    top_match_bonus = 0.1 if max_score > 0.85 else 0.0

    # Combined confidence (weighted)
    confidence = (
        relevance_score * 0.7 +           # 70% from average relevance
        consistency_penalty * 0.2 +       # 20% from consistency
        top_match_bonus                    # 10% bonus for excellent match
    )

    # Clamp to [0, 1] and round to 2 decimals
    return round(max(0.0, min(1.0, confidence)), 2)


def fetch_content(question: str, history: List[dict] = None) -> List[Document]:
    """
    Fetch content using dynamic retrieval parameters and query expansion.

    Args:
        question: User question
        history: Conversation history for context-aware expansion
    """
    if history is None:
        history = []

    # Apply query expansion if enabled
    if ENABLE_QUERY_EXPANSION:
        expansion_result = expand_query(
            question,
            conversation_history=history,
            llm=llm_rewriter if ENABLE_LLM_REWRITING else None,
            enable_llm_rewriting=ENABLE_LLM_REWRITING
        )
        enhanced_question = expansion_result["expanded_query"]
    else:
        enhanced_question = question

    retriever, _ = get_dynamic_retriever(enhanced_question)
    return retriever.invoke(enhanced_question)


def fetch_content_with_scores(
    question: str,
    history: List[dict] = None
) -> Tuple[List[Document], float, Dict, Dict]:
    """
    Fetch content with dynamic retrieval, query expansion, and confidence scoring.

    Args:
        question: User question
        history: Conversation history for context

    Returns:
        Tuple of (documents, confidence_score, query_analysis, expansion_result)
    """
    if history is None:
        history = []

    # Apply query expansion if enabled
    expansion_result = {}
    enhanced_question = question

    if ENABLE_QUERY_EXPANSION:
        expansion_result = expand_query(
            question,
            conversation_history=history,
            llm=llm_rewriter if ENABLE_LLM_REWRITING else None,
            enable_llm_rewriting=ENABLE_LLM_REWRITING
        )
        enhanced_question = expansion_result["expanded_query"]

    # Get dynamic retriever based on enhanced question
    retriever, analysis = get_dynamic_retriever(enhanced_question)

    # Retrieve documents using enhanced question
    docs = retriever.invoke(enhanced_question)
    confidence = calculate_confidence_score(docs)

    return docs, confidence, analysis, expansion_result

def combined_question(question: str, history: List[dict] = []) -> str:
    """Combine current question with conversation history."""
    prior = "\n".join(m["content"] for m in history if m.get("role") == "user")
    return (prior + "\n" if prior else "") + question

def answer_question(
    question: str,
    history: List[dict] = []
) -> Tuple[str, List[Document], float, Dict, Dict]:
    """
    Answer a question with confidence score, query analysis, and expansion info.

    Returns:
        Tuple of (answer, documents, confidence_score, query_analysis, expansion_result)
    """
    combined = combined_question(question, history)
    docs, confidence, analysis, expansion = fetch_content_with_scores(combined, history)
    context = "\n".join(doc.page_content for doc in docs)

    system_prompt = SYSTEM_PROMPT.format(context=context)
    messages = [SystemMessage(content=system_prompt)]
    messages.extend(convert_to_messages(history))
    messages.append(HumanMessage(content=question))

    response = llm.invoke(messages)
    return response.content, docs, confidence, analysis, expansion

def stream_answer(
    question: str,
    history: List[dict] = []
) -> Iterator[Tuple[str, List[Document], float, Dict, Dict]]:
    """
    Stream answer with confidence score, query analysis, and expansion info.

    Yields:
        Tuple of (answer_chunk, documents, confidence_score, query_analysis, expansion_result)
    """
    combined = combined_question(question, history)
    docs, confidence, analysis, expansion = fetch_content_with_scores(combined, history)
    context = "\n".join(doc.page_content for doc in docs)

    system_prompt = SYSTEM_PROMPT.format(context=context)
    messages = [SystemMessage(content=system_prompt)]
    messages.extend(convert_to_messages(history))
    messages.append(HumanMessage(content=question))

    for chunk in llm.stream(messages):
        yield (chunk.content or ""), docs, confidence, analysis, expansion